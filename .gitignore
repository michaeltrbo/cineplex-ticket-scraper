# Ignore the Python virtual environment directory
.venv/

# Ignore local runtime logs and test caches
*.log
.pytest_cache/

# Optional: ignore common Python cache files
__pycache__/
*.py[cod]

# Ignore local configuration files
config.json
.env

# Ignore task scheduler scripts and XML configurations
*.ps1
*.xml
register_task.ps1
CineplexTicketChecker.xml
